{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knee_report_labels",
  "title": "Knee MRI report labels: one object per study",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "study_id",
    "study",
    "findings"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "study_id": {
      "type": "string"
    },
    "study": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_side",
        "report_type",
        "refers_to_prior",
        "hoffa_edema"
      ],
      "properties": {
        "report_side": {
          "enum": [
            "same",
            "not_stated",
            "both",
            "other"
          ]
        },
        "report_type": {
          "enum": [
            "structured",
            "narrative",
            "impression_only",
            "empty"
          ]
        },
        "refers_to_prior": {
          "type": "boolean"
        },
        "hoffa_edema": {
          "enum": [
            true,
            false,
            null
          ]
        }
      }
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acl",
        "mcl",
        "medial_meniscus",
        "lateral_meniscus",
        "medial_oa",
        "lateral_oa",
        "pf_oa",
        "effusion",
        "synovitis",
        "bakers_cyst",
        "contusion",
        "fracture"
      ],
      "properties": {
        "acl": {
          "$ref": "#/$defs/acl"
        },
        "mcl": {
          "$ref": "#/$defs/mcl"
        },
        "medial_meniscus": {
          "$ref": "#/$defs/meniscus"
        },
        "lateral_meniscus": {
          "$ref": "#/$defs/meniscus"
        },
        "medial_oa": {
          "$ref": "#/$defs/oa"
        },
        "lateral_oa": {
          "$ref": "#/$defs/oa"
        },
        "pf_oa": {
          "$ref": "#/$defs/oa"
        },
        "effusion": {
          "$ref": "#/$defs/effusion"
        },
        "synovitis": {
          "$ref": "#/$defs/basic"
        },
        "bakers_cyst": {
          "$ref": "#/$defs/bakers_cyst"
        },
        "contusion": {
          "$ref": "#/$defs/contusion"
        },
        "fracture": {
          "$ref": "#/$defs/fracture"
        }
      }
    }
  },
  "$defs": {
    "status": {
      "enum": [
        "meets",
        "unsettled",
        "hedged",
        "below",
        "excluded",
        "denied",
        "structure_normal",
        "general_normal",
        "not_mentioned",
        "conflict"
      ]
    },
    "missing": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "size",
          "grade",
          "extent",
          "cause",
          "acuity",
          "compartment",
          "type"
        ]
      }
    },
    "quote": {
      "type": "string",
      "maxLength": 300
    },
    "rules": {
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unsettled"
              }
            }
          },
          "then": {
            "properties": {
              "missing": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "missing": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_mentioned"
              }
            }
          },
          "then": {
            "properties": {
              "quote": {
                "maxLength": 0
              }
            }
          },
          "else": {
            "properties": {
              "quote": {
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "ligament_grade": {
      "enum": [
        "degeneration",
        "low_grade",
        "low_to_partial",
        "partial",
        "high_grade",
        "complete",
        null
      ]
    },
    "acuity": {
      "enum": [
        "acute",
        "subacute",
        "chronic",
        null
      ]
    },
    "basic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "missing",
        "quote"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "missing": {
          "$ref": "#/$defs/missing"
        },
        "quote": {
          "$ref": "#/$defs/quote"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/rules"
        }
      ]
    },
    "acl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "missing",
        "quote",
        "grade",
        "acuity",
        "graft"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "missing": {
          "$ref": "#/$defs/missing"
        },
        "quote": {
          "$ref": "#/$defs/quote"
        },
        "grade": {
          "$ref": "#/$defs/ligament_grade"
        },
        "acuity": {
          "$ref": "#/$defs/acuity"
        },
        "graft": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/rules"
        }
      ]
    },
    "mcl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "missing",
        "quote",
        "grade",
        "acuity"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "missing": {
          "$ref": "#/$defs/missing"
        },
        "quote": {
          "$ref": "#/$defs/quote"
        },
        "grade": {
          "$ref": "#/$defs/ligament_grade"
        },
        "acuity": {
          "$ref": "#/$defs/acuity"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/rules"
        }
      ]
    },
    "oa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "missing",
        "quote",
        "depth",
        "size_mm",
        "extent",
        "severity_word"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "missing": {
          "$ref": "#/$defs/missing"
        },
        "quote": {
          "$ref": "#/$defs/quote"
        },
        "depth": {
          "enum": [
            "superficial",
            "partial",
            "deep",
            "full",
            null
          ]
        },
        "size_mm": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "extent": {
          "enum": [
            "focal",
            "multifocal",
            "diffuse",
            null
          ]
        },
        "severity_word": {
          "enum": [
            "mild",
            "mild_to_moderate",
            "moderate",
            "moderate_to_severe",
            "severe",
            null
          ]
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/rules"
        }
      ]
    },
    "effusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "missing",
        "quote",
        "size"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "missing": {
          "$ref": "#/$defs/missing"
        },
        "quote": {
          "$ref": "#/$defs/quote"
        },
        "size": {
          "enum": [
            "none",
            "trace",
            "small",
            "mild",
            "mild_to_moderate",
            "moderate",
            "large",
            null
          ]
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/rules"
        }
      ]
    },
    "bakers_cyst": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "missing",
        "quote",
        "size",
        "longest_mm"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "missing": {
          "$ref": "#/$defs/missing"
        },
        "quote": {
          "$ref": "#/$defs/quote"
        },
        "size": {
          "enum": [
            "small",
            "moderate",
            "large",
            null
          ]
        },
        "longest_mm": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/rules"
        }
      ]
    },
    "contusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "missing",
        "quote",
        "cause",
        "bones"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "missing": {
          "$ref": "#/$defs/missing"
        },
        "quote": {
          "$ref": "#/$defs/quote"
        },
        "cause": {
          "enum": [
            "trauma",
            "degeneration",
            "fracture",
            "insufficiency",
            "other",
            null
          ]
        },
        "bones": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "medial_femoral_condyle",
              "lateral_femoral_condyle",
              "femur_other",
              "medial_tibial_plateau",
              "lateral_tibial_plateau",
              "tibia_other",
              "patella",
              "fibula"
            ]
          }
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/rules"
        }
      ]
    },
    "fracture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "missing",
        "quote",
        "acuity"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "missing": {
          "$ref": "#/$defs/missing"
        },
        "quote": {
          "$ref": "#/$defs/quote"
        },
        "acuity": {
          "$ref": "#/$defs/acuity"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/rules"
        }
      ]
    },
    "meniscus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "missing",
        "quote",
        "location",
        "displaced_fragment"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "missing": {
          "$ref": "#/$defs/missing"
        },
        "quote": {
          "$ref": "#/$defs/quote"
        },
        "location": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "anterior_horn",
              "body",
              "posterior_horn",
              "anterior_root",
              "posterior_root"
            ]
          }
        },
        "displaced_fragment": {
          "enum": [
            true,
            false,
            null
          ]
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/rules"
        }
      ]
    }
  }
}
